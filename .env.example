# Copy to .env and fill in (or run `npm run setup`). .env is git-ignored – never commit it.

# --- homee ---
# local = via HOMEE_IP in your home network, remote = via the homee cloud (<HOMEE_ID>.hom.ee)
HOMEE_MODE=local
HOMEE_IP=192.168.1.50
# 12-character homee ID (homee app: Settings > homee)
HOMEE_ID=
HOMEE_USER=
HOMEE_PASSWORD=
# homee allows only one connection per device name
HOMEE_DEVICE_NAME=cubepilot-for-homee

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5311
# Optional, but required as soon as the backend listens on anything other than localhost.
# Sent by the frontend and the MCP server as header "x-api-key".
API_TOKEN=
# true = never send write commands to homee (read-only)
READ_ONLY=false
# true = allow raw commands (e.g. "GET:all", "PUT:...") via /api/raw – for exploring the API
ALLOW_RAW=false
# number of automatic backups to keep (manual and uploaded backups are never removed)
KEEP_AUTO_BACKUPS=200

# --- MCP ---
HOMEE_BACKEND_URL=http://127.0.0.1:5311
# true = the MCP server starts the backend if it isn't running (local address only)
MCP_AUTOSTART_BACKEND=true
